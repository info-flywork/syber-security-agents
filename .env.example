# Site Gözcü ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun: cp .env.example .env
# .env asla git'e eklenmez. Değerlerde "$" karakteri kullanmayın (docker compose onu değişken sanar).

# ——— Uygulama ———
# Panelin dışarıdan görünen adresi (sonunda / olmadan)
PUBLIC_URL=https://srv1548849.hstgr.cloud
# 2FA sırlarını şifreleyen anahtar: openssl rand -hex 32  (sonradan değiştirilirse herkesin 2FA'sı sıfırlanmalı)
APP_SECRET=
# PostgreSQL bağlantısı. Sunucuda: postgres://sitegozcu:<şifre>@host.docker.internal:5432/sitegozcu
DATABASE_URL=

# ——— E-posta (uyarılar ve ekip davetleri) ———
SMTP_HOST=smail07.doruk.net.tr
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=support@arconai.net
SMTP_FROM=support@arconai.net
SMTP_FROM_NAME=Site Gözcü
SMTP_PASS=

# ——— Traefik (sadece docker-compose.yml için) ———
DOMAIN=srv1548849.hstgr.cloud
# n8n'in Traefik'inin bağlı olduğu Docker ağı ve sertifika çözücüsünün adı (kurulum adımlarında nasıl bulunacağı yazıyor)
TRAEFIK_NETWORK=
CERT_RESOLVER=
TRAEFIK_ENTRYPOINT=websecure

# ——— Sadece yerel geliştirme ———
# PORT=3000
# ALLOW_PRIVATE=1   # localhost / iç ağ adreslerini izlemeye izin verir; sunucuda ASLA açmayın
# CRON=0            # zamanlayıcıyı kapatır
